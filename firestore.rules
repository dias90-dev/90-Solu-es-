rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    
    // User Profile
    function isValidUserProfile(data) {
      return data.keys().hasAll(['credits', 'plan', 'lastResetWeek', 'createdAt', 'email'])
        && data.credits is number && data.credits >= 0
        && data.plan is string && (data.plan == 'free' || data.plan == 'pro')
        && data.lastResetWeek is number && data.lastResetWeek >= 0
        && data.createdAt == request.time
        && data.email is string;
    }
    
    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId
                    && isValidId(userId)
                    && isValidUserProfile(incoming());
      allow update: if isSignedIn() && request.auth.uid == userId
                    && incoming().diff(existing()).affectedKeys().hasOnly(['credits', 'plan', 'lastResetWeek'])
                    && incoming().createdAt == existing().createdAt
                    && incoming().credits is number && incoming().credits >= 0
                    && (incoming().keys().hasAll(['plan']) ? (incoming().plan == 'free' || incoming().plan == 'pro') : true)
                    && incoming().lastResetWeek is number && incoming().lastResetWeek >= 0;
    }
    
    // Song
    function isValidSongCreate(data) {
      return data.keys().hasAll(['ownerId', 'title', 'genre', 'tempo', 'songData', 'createdAt']) 
        && data.ownerId is string && data.ownerId == request.auth.uid
        && data.title is string && data.title.size() <= 256
        && data.genre is string && data.genre.size() <= 128
        && data.tempo is number && data.tempo >= 60 && data.tempo <= 240
        && data.songData is string && data.songData.size() <= 600000
        && (data.keys().hasAll(['prompt']) ? data.prompt is string : true)
        && data.createdAt == request.time;
    }
    
    match /songs/{songId} {
      allow read: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn()
                    && isValidId(songId)
                    && isValidSongCreate(incoming())
                    && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid));
      allow update: if isSignedIn() && existing().ownerId == request.auth.uid
                    && incoming().ownerId == existing().ownerId
                    && incoming().createdAt == existing().createdAt
                    && incoming().diff(existing()).affectedKeys().hasOnly(['title'])
                    && incoming().title is string && incoming().title.size() <= 256;
      allow delete: if isSignedIn() && existing().ownerId == request.auth.uid;
    }
  }
}
